# Every variable is optional. With none set, the app runs fully on curated content:
# photo help shows "Demo mode", read-aloud uses the device voice, content is bundled.
# Never put secrets in NEXT_PUBLIC_* variables.

# --- Gemini API (photo helper) — key from https://aistudio.google.com/apikey, server-side only ---
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
# Used automatically if the primary model errors
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# --- ElevenLabs ("Listen to your mission") — server-side only ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EeQEodFZVtBkjtgK3HBc
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Where generated audio is cached at runtime (default: OS temp dir; ephemeral on Render/Vercel)
AUDIO_CACHE_DIR=

# --- MongoDB Atlas (curated content source; read-only user recommended) ---
MONGODB_URI=
MONGODB_DATABASE=nature_by_friends

# --- HTTP ---
# Extra origins allowed to call /api/* cross-origin (comma-separated). Same-origin always works.
ALLOWED_ORIGINS=
# Requests per minute per IP for the content endpoint (identify=10, audio=30 are fixed in code)
RATE_LIMIT_MAX_REQUESTS=60
NEXT_PUBLIC_APP_URL=http://localhost:3000
